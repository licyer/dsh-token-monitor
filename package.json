{
  "name": "dsh-token-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Web 会话头部大模型余量监控插件：当前模型额度徽标 + 全部供应商详情弹层",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js"
  ]
}
